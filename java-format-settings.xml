<?xml version="1.0" encoding="UTF-8"?>
<profiles>
  <profile>
    <name>eclipse-java-google-style</name>
    <settings>
      <!-- Based on Google Java Style Guide -->
      <!-- Indentation -->
      <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="2"/>
      <setting id="org.eclipse.jdt.core.formatter.tab.size" value="2"/>
      <setting id="org.eclipse.jdt.core.formatter.tab.char" value="space"/>
      
      <!-- Line wrapping -->
      <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="100"/>
      
      <!-- Braces -->
      <setting id="org.eclipse.jdt.core.formatter.brace_position_for_type_declaration" value="end_of_line"/>
      <setting id="org.eclipse.jdt.core.formatter.brace_position_for_method_declaration" value="end_of_line"/>
      <setting id="org.eclipse.jdt.core.formatter.brace_position_for_block" value="end_of_line"/>
      <setting id="org.eclipse.jdt.core.formatter.brace_position_for_switch" value="end_of_line"/>
      
      <!-- Spaces before/after parentheses -->
      <setting id="org.eclipse.jdt.core.formatter.space_before_opening_paren_in_method_invocation" value="false"/>
      <setting id="org.eclipse.jdt.core.formatter.space_before_opening_paren_in_method_declaration" value="false"/>
      <setting id="org.eclipse.jdt.core.formatter.space_before_opening_paren_in_if" value="true"/>
      <setting id="org.eclipse.jdt.core.formatter.space_before_opening_paren_in_for" value="true"/>
      <setting id="org.eclipse.jdt.core.formatter.space_before_opening_paren_in_while" value="true"/>
      <setting id="org.eclipse.jdt.core.formatter.space_before_opening_paren_in_catch" value="true"/>
      
      <!-- Blank lines -->
      <setting id="org.eclipse.jdt.core.formatter.blank_lines_between_type_declarations" value="2"/>
      <setting id="org.eclipse.jdt.core.formatter.blank_lines_before_method" value="1"/>
      <setting id="org.eclipse.jdt.core.formatter.blank_lines_after_class_header" value="0"/>
      
      <!-- Member positioning -->
      <setting id="org.eclipse.jdt.core.formatter.keep_type_declaration_on_one_line" value="false"/>
      <setting id="org.eclipse.jdt.core.formatter.keep_method_body_on_one_line" value="false"/>
      
      <!-- Imports -->
      <setting id="org.eclipse.jdt.core.formatter.number_of_empty_lines_to_preserve" value="1"/>
      <setting id="org.eclipse.jdt.core.formatter.disabling_tag" value="@formatter:off"/>
      <setting id="org.eclipse.jdt.core.formatter.enabling_tag" value="@formatter:on"/>
    </settings>
  </profile>
</profiles>
